{
  "layer": "top",
  "height": 24,
  "spacing": 0,

  "modules-left": ["battery", "cpu", "memory", "wlr/taskbar", "tray", "custom/anki-word"],
  "modules-center": ["niri/window"],
  "modules-right": [
    "custom/recorder",
    "custom/color-picker",
    "custom/dnd",
    "custom/vpn",
    "network",
    "bluetooth",
    "wireplumber#source",
    "wireplumber#sink",
    "backlight",
    "clock"
  ],

  "cpu": {
    "format": "{usage}% ",
    "on-click": "missioncenter"
  },
  "memory": {
    "format": "{}% ",
    "on-click": "missioncenter"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "tooltip-format": "{title} | {app_id}",
    "on-click": "activate",
    "on-click-middle": "close",
    "on-click-right": "fullscreen",
    "icon-size": 15
  },
  "clock": {
    "tooltip-format": "<big>{:%a, %b %d}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M}"
  },
  "tray": {
    "spacing": 18
  },
  "niri/window": {
    "separate-outputs": true,
    "swap-icon-label": false,
    "max-length": 40,
    "tooltip": false
  },
  "network": {
    "format": "{icon}",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr} via {gwaddr}",
    "format-icons": {
      "wifi": "󰖩",
      "ethernet": "󰖩",
      "disconnected": "󱛅",
      "disabled": "󰖪"
    },
    "on-click": "kitty -e nmtui"
  },
  "bluetooth": {
    "format": "{icon}",
    "tooltip-format": "{controller_alias}",
    "tooltip-format-connected": "{controller_alias} ({controller_address})\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} ({device_address})",
    "tooltip-format-enumerate-connected-battery": "{device_alias} ({device_address}) {device_battery_percentage}% 󰂎",
    "format-icons": {
      "on": "󰂯",
      "off": "󰂲",
      "connected": "󰂱"
    },
    "on-click": "kitty -e bluetui"
  },
  "wireplumber#sink": {
    "node-type": "Audio/Sink",
    "format": "{volume}% {icon}",
    "format-muted": "",
    "format-icons": {
      "headphone": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "wireplumber#source": {
    "node-type": "Audio/Source",
    "format": "󰍬",
    "format-muted": "󰍭",
    "on-click": "$HOME/Scripts/toggle-mute.sh",
    "on-scroll-up": "",
    "on-scroll-down": "",
    "scroll-step": 0
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""],
    "tooltip-format": "Backlight: {percent}%"
  },
  "battery": {
    "states": { "warning": 15, "critical": 5 },
    "format": "{capacity}% {icon}",
    "format-charging": "{capacity}% 󰂄",
    "format-plugged": "{capacity}% 󰂄",
    "format-icons": ["󰂃", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery: {capacity}%"
  },
  "custom/color-picker": {
    "format": "",
    "tooltip-format": "Pick color",
    "on-click": "$HOME/Scripts/pick-color.sh"
  },
  "custom/dnd": {
    "return-type": "json",
    "exec": "$HOME/Scripts/waybar-dnd-exec.sh",
    "on-click": "$HOME/Scripts/toggle-dnd.sh"
  },
  "custom/vpn": {
    "return-type": "json",
    "exec": "$HOME/Scripts/waybar-vpn-exec.sh",
    "on-click": "$HOME/Scripts/toggle-vpn.sh"
  },
  "custom/recorder": {
    "return-type": "json",
    "exec": "$HOME/Scripts/waybar-recorder-exec.sh",
    "on-click": "$HOME/Scripts/toggle-recording.sh"
  },
  "custom/anki-word": {
    "exec": "$HOME/Scripts/random-anki-word.py",
    "on-click": "",
    "on-click-right": "anki",
    "tooltip-format": "Word of the hour: {text}",
    "restart-interval": 3600
  }
}
