///// Show wallpaper within backdrop /////
layer-rule {
    match namespace="^wallpaper$"
    match at-startup=true

    place-within-backdrop true
}

///// Global window rules /////
window-rule {
    geometry-corner-radius 5
    clip-to-geometry true
    tiled-state true
    open-maximized true
    draw-border-with-background false
    open-maximized-to-edges false
}

///// Change border on focused windows /////
window-rule {
    match is-focused=true

    border {
        width 1.5
        active-color "#a09bc2"
        inactive-color "#00000059"
        urgent-color "#5e6775"
    }
}

///// Disable blur for non-transparent apps /////
window-rule {
    match app-id="^anki$"                                                  // Anki
    match app-id="^timeshift-gtk$"                                         // Timeshift
    match app-id="^org.kde.krita$"                                         // Krita
    match app-id="^net.drawpile.drawpile$"                                 // Drawpile
    match app-id="^io.github.celluloid_player.Celluloid$"                  // Celluloid
    match app-id="^mpv$"                                                   // MPV
    match app-id="^chromium$"                                              // Chromium
    match app-id="^org.gnome.DiskUtility$"                                 // Gnome Disks
    match app-id="^org.gnome.Geary$"                                       // Geary
    match app-id="^virt-manager$"                                          // Virt Manager
    match app-id="^tlpui$"                                                 // TLP UI
    match app-id="^libreoffice"                                            // LibreOffice
    match app-id="^net.lutris.Lutris$"                                     // Lutris
    match app-id="\\.exe$"                                                 // Wine apps
    match app-id="^org.prismlauncher.PrismLauncher$"                       // Prism Launcher
    match app-id="^steam$"                                                 // Steam
    match app-id="^gamescope$"                                             // Gamescope

    background-effect {
        blur false
    }
}

///// Switch to non-xray blur for floating windows /////
window-rule {
    match is-floating=true

    background-effect {
        xray false
    }
}

///// Fix window transparency /////
window-rule {
    match app-id="^zen$"                                                     // Zen Browser
    match app-id="^md.Obsidian$"                                             // Obsidian
    match app-id="^code$"                                                    // VS Code

    opacity 0.9999999
}

///// Tiled full width /////
window-rule {
    match app-id="^net.lutris.Lutris$" title="Lutris settings"               // Lutris settings

    default-column-width { proportion 1.0; }
    open-floating false
    open-maximized false
}

///// Tiled half width /////
window-rule {
    match app-id="^kitty$"                                                   // Kitty
    match app-id="^org.gnome.Nautilus$" title=".+"                           // Nautilus
    match app-id="^org.gnome.FileRoller$"                                    // File Roller
    match app-id="^org.x.GnomeOnlineAccountsGtk$"                            // Gnome Online Accounts
    match app-id="^anki$" title="^Edit|^Add|^Statistics"                     // Anki add / edit note, add-ons, stats
    match app-id="^org.prismlauncher.PrismLauncher$" title="^Prism Launcher" // Prism Launcher
    match app-id="^org.pulseaudio.pavucontrol$" title="^Volume Control$"     // Volume Control
    match app-id="^com.transmissionbt.transmission" title="^Transmission$"   // Transmission
    match app-id="^timeshift-gtk$" title="^Restore Snapshot$"                // Timeshift restore snapshot window
    match app-id="^evolution-alarm-notify$" title="^Reminders$"              // Evolution calendar event reminders
    match app-id="^net.lutris.Lutris$" title="^Add games to Lutris$"         // Some Lutris dialogs
    match app-id="^net.lutris.Lutris$" title="^Configure "                   // ...

    default-column-width { proportion 0.5; }
    open-floating false
    open-maximized false
}

///// Floating /////
window-rule {
    match app-id="^veracrypt$" title="^Administrator privileges required$"   // VeraCrypt password prompts
    match app-id="^veracrypt$" title="^Enter password for"                   // ...
    match app-id="^zen$" title="^Picture-in-Picture$"                        // Zen Picture-in-Picture overlays
    match app-id="^org.gnome.Geary$" title="^Untrusted Connection$"          // Geary untrusted connection popups
    match app-id="^org.kde.krita$" title="[^ *] [—–] Krita$"                 // Some Krita windows

    open-floating true
}

///// Floating 900 x 600 /////
window-rule {
    match app-id="^org.gnome.Nautilus$" title="^Open folder as vault$"       // Obsidian vault opening window

    open-floating true
    default-column-width { fixed 900; }
    default-window-height { fixed 600; }
}

///// Floating 250 x 150 in the corner /////
window-rule {
    match app-id="^XEyes$" title="^xeyes$"                                   // XEyes

    open-floating true
    default-column-width { fixed 250; }
    default-window-height { fixed 150; }
    default-floating-position x=12 y=12
}
