cursor {
    xcursor-theme "Bibata-Modern-Classic"
    xcursor-size 22
    hide-when-typing
    hide-after-inactive-ms 10000
}

input {
    keyboard {
        numlock
        xkb { layout "us, ru"; }
    }

    touchpad {
        tap
        natural-scroll
    }

    tablet {
        // Drawing tablet screen
        map-to-output "PNP(GAM) PD2200 0x00000001"
    }
}

gestures {
    hot-corners { off; }
}
