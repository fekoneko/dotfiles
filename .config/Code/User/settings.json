  "[flow]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[ember]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[graphql]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  "[python]": { "editor.tabSize": 4 },
  "[shellscript]": { "editor.tabSize": 4 },
  "[powershell]": { "editor.tabSize": 4 },
  "[kdl]": { "editor.tabSize": 4 },
  "[qml]": {
    "editor.defaultFormatter": "theqtcompany.qt-qml",
    "editor.tabSize": 4,
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.tabSize": 4,
  },
  "[rhai]": {
    "editor.defaultFormatter": "rhaiscript.vscode-rhai",
    "editor.tabSize": 4,
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
  },
  "[blueprint]": {
    "editor.insertSpaces": false,
  },
  "svelte.enable-ts-plugin": true,
  "editor.codeActionsOnSave": {},
