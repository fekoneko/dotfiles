{
  "editor.tabSize": 2,
  "liveServer.settings.donotShowInfoMsg": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
    "postcss": "css",
  },
  "git.enableSmartCommit": true,
  "editor.linkedEditing": true,
  "editor.formatOnSave": true,
  "editor.wordWrap": "on",
  "prettier.printWidth": 100,
  "prettier.singleQuote": true,
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[angular]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[postcss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[less]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[jsonl]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[toml]": { "editor.defaultFormatter": "tamasfe.even-better-toml", "editor.tabSize": 4 },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[mdx]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[flow]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[ember]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[graphql]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[svelte]": { "editor.defaultFormatter": "svelte.svelte-vscode" },
  "[python]": { "editor.tabSize": 4 },
  "[kdl]": { "editor.tabSize": 4 },
  "[qml]": { "editor.tabSize": 4 },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.tabSize": 4,
  },
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.tabSize": 4,
    "editor.insertSpaces": false,
  },
  "[blueprint]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": false,
  },
  "svelte.enable-ts-plugin": true,
  "editor.codeActionsOnSave": {},
  "css.lint.unknownAtRules": "ignore",
  "git.ignoreRebaseWarning": true,
  "git.confirmSync": false,
  "workbench.startupEditor": "none",
  "workbench.editorAssociations": {
    "{hexdiff}:/**/*.*": "hexEditor.hexedit",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.qrc": "default",
    "{git,gitlens,chat-editing-snapshot-text-model,copilot,git-graph,git-graph-3}:/**/*.ui": "default",
    "*.OBJ": "hexEditor.hexedit",
    "*.qrc": "qt-core.qrcEditor",
  },
  "zenMode.hideLineNumbers": false,
  "zenMode.showTabs": "single",
  "editor.cursorSurroundingLines": 999,
  "settingsSync.ignoredSettings": [
    "editor.fontFamily",
    "editor.fontSize",
    "gitlens.currentLine.fontFamily",
    "terminal.integrated.fontFamily",
    "terminal.integrated.fontSize",
  ],
  "supermaven.enable": {
    "*": true,
  },
  "cssVariables.lookupFiles": [
    "**/*.css",
    "**/*.scss",
    "**/*.sass",
    "**/*.less",
    "node_modules/@mantine/core/styles.css",
  ],
  "editor.largeFileOptimizations": false,
  "svg.preview.mode": "svg",
  "reactTsScss.diagnostics": false,
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "vscode-neovim.statusLineSeparator": "  |  ",
  "vscode-neovim.compositeKeys": {
    "jj": { "command": "vscode-neovim.escape" },
    "kk": { "command": "vscode-neovim.escape" },
  },
  "editor.fontFamily": "'JetBrainsMono Nerd Font Mono', monospace",
  "editor.fontLigatures": true,
  "terminal.integrated.fontSize": 13,
  "editor.renderWhitespace": "none",
  "zenMode.centerLayout": false,
  "workbench.editor.showTabs": "single",
  "workbench.activityBar.location": "hidden",
  "chat.commandCenter.enabled": false,
  "window.autoDetectColorScheme": true,
  "editor.renderLineHighlight": "none",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.tree.indent": 6,
  "window.customMenuBarAltFocus": false,
  "window.enableMenuBarMnemonics": false,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.preferences.useAliasesForRenames": false,
  "typescript.preferences.useAliasesForRenames": false,
  "telemetry.telemetryLevel": "off",
  "git.autofetch": true,
  "editor.acceptSuggestionOnCommitCharacter": false,
  "explorer.confirmDragAndDrop": false,
  "gitlens.launchpad.indicator.enabled": false,
  "files.associations": { "*.ui": "xml" },
  "gitlens.graph.minimap.enabled": false,
  "todohighlight.keywords": [
    { "text": "TODO:", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "ToDo:", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "Todo:", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "todo:", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "TODO ", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "ToDo ", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "Todo ", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "todo ", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "TODO(", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "ToDo(", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "Todo(", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "todo(", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "todo!", "color": "#ffffff", "backgroundColor": "#4c9957" },
    { "text": "FIXME:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "FixMe:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Fixme:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "fixme:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "FIXME ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "FixMe ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Fixme ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "fixme ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "FIXME(", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "FixMe(", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Fixme(", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "fixme(", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "NOTE:", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "Note:", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "note:", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "NOTE ", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "Note ", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "note ", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "NOTE(", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "Note(", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "note(", "color": "#ffffff", "backgroundColor": "#587cd2" },
    { "text": "SAFETY:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Safety:", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "SAFETY ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Safety ", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "SAFETY(", "color": "#ffffff", "backgroundColor": "#d2587c" },
    { "text": "Safety(", "color": "#ffffff", "backgroundColor": "#d2587c" },
  ],
  "javascript.preferences.importModuleSpecifier": "non-relative",
  "typescript.preferences.importModuleSpecifier": "non-relative",
  "reactTsScss.cssSyntaxColor": false,
  "window.menuBarVisibility": "hidden",
  "workbench.layoutControl.enabled": false,
  "workbench.navigationControl.enabled": false,
  "window.commandCenter": false,
  "editor.minimap.renderCharacters": false,
  "git.replaceTagsWhenPull": true,
  "workbench.preferredDarkColorTheme": "fekoneko-theme",
  "git.pruneOnFetch": true,
  "gitlens.telemetry.enabled": false,
  "telemetry.feedback.enabled": false,
  "telemetry.editStats.enabled": false,
  "workbench.editor.empty.hint": "hidden",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.titleBarStyle": "native",
  "security.promptForLocalFileProtocolHandling": false,
  "terminal.integrated.initialHint": false,
  "qt-core.additionalQtPaths": [
    {
      "name": "Qt-5.15.18-linux-g++_from_PATH",
      "path": "/usr/sbin/qmake",
    },
  ],
  "qt-qml.qmlls.useQmlImportPathEnvVar": true,
}
