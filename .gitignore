*

# ----------------------- ~ -----------------------

!/README.md
!/.gitignore

# shell configuration
!/.bash_profile
!/.bashrc
!/.inputrc

# theming
!/.face
!/.wallpaper
!/.lock-wallpaper

# gtk2
!/.gtkrc-2.0

# ------------------- ~/.config -------------------

!/.config/

# fontconfig
!/.config/fontconfig/
!/.config/fontconfig/fonts.conf

# niri
!/.config/niri/
!/.config/niri/**/*.kdl

# quickshell
!/.config/quickshell/
!/.config/quickshell/**/*
/.config/quickshell/.qmlls.ini

# walker
!/.config/walker/
!/.config/walker/config.toml
!/.config/walker/themes/
!/.config/walker/themes/**/*

# elephant
!/.config/elephant/
!/.config/elephant/*.toml
!/.config/elephant/menus/
!/.config/elephant/menus/*.toml
!/.config/elephant/menus/*.lua

# wl-kbptr
!/.config/wl-kbptr/
!/.config/wl-kbptr/config

# gtklock
!/.config/gtklock/
!/.config/gtklock/config.ini
!/.config/gtklock/style.css
!/.config/gtklock/layout.ui

# kitty
!/.config/kitty/
!/.config/kitty/*.conf

# fastfetch
!/.config/fastfetch/
!/.config/fastfetch/config.jsonc
!/.config/fastfetch/logo.png
!/.config/fastfetch/logo.txt

# vscode
!/.config/code-flags.conf
!/.config/Code/
!/.config/Code/User/
!/.config/Code/User/settings.json
!/.config/Code/User/keybindings.json
!/.config/Code/User/snippets/
!/.config/Code/User/snippets/**/*

# gtk3
!/.config/gtk-3.0/
!/.config/gtk-3.0/settings.ini

# gtk4
!/.config/gtk-4.0/
!/.config/gtk-4.0/settings.ini

# foliate
!/.config/com.github.johnfactotum.Foliate/
!/.config/com.github.johnfactotum.Foliate/user-stylesheet.css

# krita shortcuts
!/.config/kritashortcutsrc

# zen custom css
!/.config/zen/
!/.config/zen/fekoneko/
!/.config/zen/fekoneko/chrome/
!/.config/zen/fekoneko/chrome/userChrome.css

# ---------------- ~/.local/share ----------------

!/.local/
!/.local/share/

# fcitx5 themes
!/.local/share/fcitx5/
!/.local/share/fcitx5/themes/
!/.local/share/fcitx5/themes/**/*

# some krita resources
!/.local/share/krita/
!/.local/share/krita/color-schemes
!/.local/share/krita/color-schemes/fekoneko-theme.colors
!/.local/share/krita/input/
!/.local/share/krita/input/fekoneko input profile.profile
!/.local/share/krita/brushes/
!/.local/share/krita/brushes/fekoneko_angled_brushtip.gbr
!/.local/share/krita/paintoppresets/
!/.local/share/krita/paintoppresets/fekoneko_fun_brush.kpp
!/.local/share/krita/paintoppresets/fekoneko_angled_brush.kpp

# dbus service overrides
!/.local/share/dbus-1/
!/.local/share/dbus-1/services/
!/.local/share/dbus-1/services/*.service

# ----------------- ~/.local/bin ------------------

!/.local/
!/.local/bin/

# nautilus patch
!/.local/bin/nautilus

# foliate patch
!/.local/bin/foliate

# timeshift patch
!/.local/bin/timeshift-launcher

# discord patch
!/.local/bin/discord

# ---------- ~/.local/share/applications ----------

!/.local/
!/.local/share/
!/.local/share/applications/

# nautilus patch
!/.local/share/applications/org.gnome.Nautilus.desktop

# discord patch
!/.local/share/applications/discord.desktop

# ------------------- ~/Scripts -------------------

!/Scripts/
!/Scripts/**/*
